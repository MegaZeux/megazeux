##
# Amiga platform Makefile fragment
##

ifeq (${PLATFORM},amiga)

platform_amiga_obj := ${platform_obj}/amiga
platform_amiga_objs := \
  ${platform_amiga_obj}/platform_amiga.o \

-include ${platform_amiga_objs:.o=.d}
${platform_amiga_objs}: \
 $(filter_out $(wildcard ${platform_amiga_obj}), ${platform_amiga_obj})

build_dirs    += ${platform_amiga_obj}
platform_objs += ${platform_amiga_objs}
core_flags    += -DCONFIG_REPLACE_MAIN

endif
