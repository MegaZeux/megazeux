#
# Unit test Makefile fragment.
#
# Unit tests require C++11.
#

.PHONY: unit unittest unit_clean

unit_src        := unit
unit_obj        := ${build_base}/${unit_src}
unit_src_audio  := ${unit_src}/audio
unit_obj_audio  := ${build_base}/${unit_src_audio}
unit_src_editor := ${unit_src}/editor
unit_obj_editor := ${build_base}/${unit_src_editor}
unit_src_io     := ${unit_src}/io
unit_obj_io     := ${build_base}/${unit_src_io}
unit_src_network:= ${unit_src}/network
unit_obj_network:= ${build_base}/${unit_src_network}
unit_src_utils  := ${unit_src}/utils
unit_obj_utils  := ${build_base}/${unit_src_utils}

build_dirs += ${unit_obj} ${unit_obj_audio} ${unit_obj_editor}
build_dirs += ${unit_obj_io} ${unit_obj_network} ${unit_obj_utils}

unit_target = mzxunit${BINEXT}

unit_objs := \
  ${unit_obj}/Unit.o                   \
  ${unit_obj}/UnitIO.o                 \
  ${unit_obj}/align.o                  \
  ${unit_obj}/expr.o                   \
  ${unit_obj}/render.o                 \
  ${unit_obj}/memcasecmp.o             \
  ${unit_obj_audio}/mixer.o            \
  ${unit_obj_io}/bitstream.o           \
  ${unit_obj_io}/memfile.o             \
  ${unit_obj_io}/path.o                \
  ${unit_obj_io}/vfs.o                 \
  ${unit_obj_io}/vio.o                 \
  ${unit_obj_io}/zip.o                 \

ifneq (${BUILD_EDITOR},)

unit_objs += \
  ${unit_obj_editor}/stringsearch.o

endif

ifneq (${BUILD_NETWORK},)

unit_objs += \
  ${unit_obj_network}/sha256.o

endif

ifneq (${BUILD_UTILS},)

unit_objs += \
  ${unit_obj_utils}/image_file.o

endif

ifeq (${PLATFORM},mingw)
unit_objs += \
  ${unit_obj}/thread_win32.o
endif

#
# Some unit tests only work with modular builds. The reason is usually
# that the component(s) being tested are far too dependent on other
# components of MegaZeux to work alone.
#
ifneq (${BUILD_MODULAR},)

unit_objs += \
  ${unit_obj}/configure.o              \
  ${unit_obj}/intake.o                 \
  ${unit_obj}/sfx.o                    \
  ${unit_obj}/thread.o                 \
  ${unit_obj}/world.o                  \

unit_ldflags += ${DSORPATH} -L. -lcore
${unit_objs}: ${core_target}

ifneq (${BUILD_EDITOR},)
unit_ldflags += ${DSORPATH} -L. -leditor
${unit_objs}: ${editor_target}
endif

ifneq (${BUILD_NETWORK},)
unit_objs += \
  ${unit_obj_network}/Manifest.o
endif

else # !BUILD_MODULAR

#
# Certain tests that don't rely on many core MZX features can be patched in
# by directly linking their objects.
#
unit_extra_objs += \
  ${io_obj}/path.o        \
  ${io_obj}/vfs.o         \
  ${io_obj}/vio.o         \
  ${io_obj}/zip.o         \
  ${io_obj}/zip_stream.o  \

endif

# Patch in a main replacement if the platform added it to main_objs.
ifneq (${main_objs},)
unit_extra_objs += ${main_objs}
unit_cflags += -DCONFIG_REPLACE_MAIN
endif

#
# Build unit tests with debug optimizations and without link-time optimzations.
# (Overrides these optimization flags from the global flags.)
#
UNIT_OPTIMIZE_FLAGS := -O0 ${UNIT_OPTIMIZE_FLAGS}
ifeq (${LTO},1)
ifeq (${HAS_F_LTO},1)
UNIT_OPTIMIZE_FLAGS := -fno-lto ${UNIT_OPTIMIZE_FLAGS}
endif
endif

#
# Build without -DDEBUG to suppress debug messages,
# build without -DNDEBUG to allow assert().
# Turn on exceptions explicitly, since the global CXXFLAGS turn them off.
#
unit_cflags ?= ${CXXFLAGS}
unit_cflags += ${UNIT_OPTIMIZE_FLAGS} -UDEBUG -UNDEBUG -DMZX_UNIT_TESTS
unit_cflags += -DUNIT_BUILD_BASE='"${build_base}"'
unit_cflags += -fexceptions -funsigned-char -std=gnu++11
unit_ldflags += ${UNIT_OPTIMIZE_FLAGS}

unit_cflags += ${SDL_CFLAGS} ${ZLIB_CFLAGS} -Umain
unit_ldflags += ${SDL_LDFLAGS} ${ZLIB_LDFLAGS}

# Required for image_file test.
ifneq (${LIBPNG},)
unit_cflags  += ${LIBPNG_CFLAGS}
unit_ldflags += ${LIBPNG_LDFLAGS}
endif

# Required for threading test.
ifeq (${PTHREAD},1)
unit_cflags  += ${PTHREAD_CFLAGS}
unit_ldflags += ${PTHREAD_LDFLAGS}
endif

# System libs need to be last in the search order.
unit_ldflags += ${ARCH_LDFLAGS} ${ARCH_LIBS}

# TODO: mingw hack
ifeq (${PLATFORM},mingw)
unit_ldflags += ${LINK_STATIC_IF_MIXED} -lstdc++ -lwinpthread
endif

# Fix compilation, issue closed despite no resolution:
# https://github.com/AmigaPorts/ppc-morphos-gcc/issues/2
ifeq (${SUBPLATFORM},morphos-ppc)
unit_ldflags += -lstdc++ -lpthread
endif

ifneq (${HAS_CXX_11},1)

unit unittest:
	$(if ${V},,@echo "Skipping unit tests (requires C++11).")

unit_clean:

else

${unit_obj}/%.o: ${unit_src}/%.cpp
	$(if ${V},,@echo "  CXX     " $<)
	${CXX} -MD ${unit_cflags} -c $< -o $@

${unit_target}: ${unit_objs} ${unit_extra_objs}
	$(if ${V},,@echo "  LINK    " $@)
	${CXX} ${unit_cflags} -o $@ ${unit_objs} ${unit_extra_objs} ${unit_ldflags}

-include ${unit_objs:.o=.d}

${unit_objs}: $(filter-out $(wildcard ${unit_obj}), ${unit_obj})
${unit_objs}: $(filter-out $(wildcard ${unit_obj_audio}), ${unit_obj_audio})
${unit_objs}: $(filter-out $(wildcard ${unit_obj_editor}), ${unit_obj_editor})
${unit_objs}: $(filter-out $(wildcard ${unit_obj_io}), ${unit_obj_io})
${unit_objs}: $(filter-out $(wildcard ${unit_obj_network}), ${unit_obj_network})
${unit_objs}: $(filter-out $(wildcard ${unit_obj_utils}), ${unit_obj_utils})

unit unittest: ${unit_target}
	${RM} -r "${build_base}/tmp"
	${MKDIR} -p "${build_base}/tmp"
	LD_LIBRARY_PATH="." LIBRARY_PATH="$$LIBRARY_PATH:." ./${unit_target}

unit_clean:
	$(if ${V},,@echo "  RM      " ${unit_obj})
	${RM} -r ${unit_obj}
	$(if ${V},,@echo "  RM      " ${unit_target})
	${RM} -r ${unit_target}

endif
